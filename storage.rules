rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/projects/{projectId}/materials/{materialId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // Uploads use authenticated server routes and their quota checks.
      allow create, update: if false;
    }
  }
}
