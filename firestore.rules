rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid} (Firebase Auth uid)
    // Fields:
    //   - plan: string (required, "free" only in beta, immutable after create)
    //   - usage: map (required) weekStart string YYYY-MM-DD, chatTurns int,
    //            practiceGenerated int, notesGenerated int, storageBytes number
    //            (storageBytes capped at 1 GiB / 1073741824; existing over-cap
    //            accounts may keep or lower, never grow)
    //   - displayName: string|null (optional, <= 120)
    //   - email: string|null (optional, <= 320)
    //   - photoURL: string|null (optional, <= 2048)
    //   - preferredModel: string|null (optional Gemini model id; legacy provider ids remain readable)
    //   - theme: string|null (optional, "light" | "dark")
    //   - createdAt: timestamp (set on create, immutable)
    //   - updatedAt: timestamp
    //
    // Subcollection: users/{uid}/memories/{memoryId}
    //   id, content (<= 200), createdAt, updatedAt
    //
    // Document: users/{uid}/profile/learning
    //   text (<= 800), updatedAt
    //
    // Collection: projects — existing owner-scoped project documents
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email == "davit.gvakharia@gmail.com" && request.auth.token.email_verified == true)
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true)
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsProject(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && (get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid);
    }

    function ownsChat(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
    }

    function sharedThread(projectId, threadId) {
      let chatId = threadId == "main" ? projectId : threadId;
      let indexPath = /databases/$(database)/documents/chats/$(chatId);
      return exists(indexPath)
        && get(indexPath).data.public == true
        && get(indexPath).data.projectId == projectId
        && (get(indexPath).data.nestedId == threadId
          || (!("nestedId" in get(indexPath).data) && threadId == "main"));
    }

    function materialIsShared() {
      return resource.data.sharedShareIds is list && resource.data.sharedShareIds.size() > 0;
    }

    function sheetIsShared() {
      return resource.data.sharedShareIds is list && resource.data.sharedShareIds.size() > 0;
    }

    function shareFieldsAbsent(data) {
      return !("public" in data) && !("shareId" in data);
    }

    function shareFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["public", "shareId"]);
    }

    function shareFieldsValid() {
      return request.resource.data.public is bool
        && ((!request.resource.data.public && !("shareId" in request.resource.data))
          || (request.resource.data.public
            && request.resource.data.shareId is string
            && request.resource.data.shareId.size() >= 32
            && request.resource.data.shareId.size() <= 128
            && request.resource.data.sharedMaterialIds is list
            && request.resource.data.sharedMaterialIds.size() <= 250
            && request.resource.data.sharedSheetIds is list
            && request.resource.data.sharedSheetIds.size() <= 250));
    }

    function shareFieldsUnchangedOrValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(["public", "shareId", "sharedMaterialIds", "sharedSheetIds"])
        || (changed.hasOnly(["public", "shareId", "sharedMaterialIds", "sharedSheetIds"]) && shareFieldsValid());
    }

    function isCompactFeedback(data) {
      return data.keys().hasOnly(["chatId", "messageId", "reason", "createdAt", "snippet"])
        && data.keys().hasAll(["chatId", "messageId", "reason", "createdAt", "snippet"])
        && data.chatId is string && data.chatId.size() > 0 && data.chatId.size() <= 160
        && data.messageId is string && data.messageId.size() > 0 && data.messageId.size() <= 160
        && data.reason is string && data.reason.size() <= 240
        && data.snippet is string && data.snippet.size() <= 240
        && (data.createdAt is timestamp || data.createdAt is string)
        && ownsChat(data.chatId);
    }

    function isValidUsage(usage) {
      return usage is map
        && usage.keys().hasOnly(["weekStart", "chatTurns", "practiceGenerated", "notesGenerated", "storageBytes"])
        && usage.weekStart is string
        && usage.weekStart.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && usage.chatTurns is number && usage.chatTurns >= 0 && usage.chatTurns <= 1000000
        && usage.practiceGenerated is number && usage.practiceGenerated >= 0 && usage.practiceGenerated <= 1000000
        && usage.notesGenerated is number && usage.notesGenerated >= 0 && usage.notesGenerated <= 1000000
        && usage.storageBytes is number && usage.storageBytes >= 0 && usage.storageBytes <= 1099511627776
        && storageWithinCap(usage);
    }

    // 1 GiB materials cap. Accounts already over the cap may keep or lower usage, never grow.
    function storageWithinCap(usage) {
      return usage.storageBytes <= 1073741824
        || (resource != null
          && resource.data.usage is map
          && resource.data.usage.storageBytes is number
          && usage.storageBytes <= resource.data.usage.storageBytes);
    }

    function isValidOptionalText(data, field, maxLen) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidPreferredModel(data) {
      return !("preferredModel" in data)
        || data.preferredModel == null
        || (data.preferredModel is string && data.preferredModel in [
          "gemini", "grok", "gpt",
          "gemini-3.1-flash-lite",
          "gemini-3.1-pro-preview",
          "gemini-3.5-flash-lite"
        ]);
    }

    function isValidTheme(data) {
      return !("theme" in data)
        || data.theme == null
        || (data.theme is string && data.theme in ["light", "dark"]);
    }

    function isValidThemeAccents(data) {
      return !("themeAccents" in data)
        || (data.themeAccents is map
          && data.themeAccents.keys().hasOnly(["light", "dark"])
          && (!("light" in data.themeAccents) || data.themeAccents.light in ["default", "blue", "red", "yellow", "green", "orange", "purple"])
          && (!("dark" in data.themeAccents) || data.themeAccents.dark in ["default", "blue", "red", "yellow", "green", "orange", "purple"]));
    }

    function isValidChatMode(data) {
      return !("chatMode" in data) || data.chatMode in ["auto", "fast", "teacher"];
    }

    function isValidHighContrast(data) {
      return !("highContrast" in data) || data.highContrast is bool;
    }

    function isValidOptionalAdmin(data) {
      return !("admin" in data) || data.admin is bool;
    }

    function adminFieldUnchanged() {
      return !("admin" in request.resource.data)
        || ("admin" in resource.data && request.resource.data.admin == resource.data.admin)
        || (!("admin" in resource.data) && request.resource.data.admin == false);
    }

    function isValidUser(data) {
      return data.keys().hasOnly(["displayName", "email", "photoURL", "plan", "usage", "preferredModel", "chatMode", "theme", "themeAccents", "highContrast", "admin", "createdAt", "updatedAt"])
        && data.keys().hasAll(["plan", "usage"])
        && data.plan in ["free", "free_beta", "lite", "pro", "max", "team"]
        && isValidUsage(data.usage)
        && isValidOptionalAdmin(data)
        && isValidOptionalText(data, "displayName", 120)
        && isValidOptionalText(data, "email", 320)
        && isValidOptionalText(data, "photoURL", 2048)
        && isValidPreferredModel(data)
        && isValidChatMode(data)
        && isValidTheme(data)
        && isValidThemeAccents(data)
        && isValidHighContrast(data)
        && (!("createdAt" in data) || data.createdAt is timestamp || data.createdAt is string)
        && (!("updatedAt" in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }

    function userPlanLocked() {
      return (!("plan" in resource.data) || resource.data.plan == request.resource.data.plan)
        && adminFieldUnchanged();
    }

    function clientCanCreatePlan() {
      return request.resource.data.plan in ["free", "free_beta"]
        && (!("admin" in request.resource.data) || request.resource.data.admin == false);
    }

    function isValidMemory(memoryId, data) {
      return data.keys().hasOnly(["id", "content", "createdAt", "updatedAt"])
        && data.keys().hasAll(["id", "content", "createdAt", "updatedAt"])
        && data.id == memoryId
        && data.content is string && data.content.size() > 0 && data.content.size() <= 200
        && (data.createdAt is timestamp || data.createdAt is string)
        && (data.updatedAt is timestamp || data.updatedAt is string);
    }

    function isValidLearning(data) {
      return data.keys().hasOnly(["text", "updatedAt"])
        && data.keys().hasAll(["text", "updatedAt"])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 800
        && (data.updatedAt is timestamp || data.updatedAt is string);
    }

    // Billing state is served by authenticated server APIs, including owner reads.
    match /billingAccounts/{document=**} { allow read, write: if false; }
    match /billingConfig/{document=**} { allow read, write: if false; }
    match /billingWebhooks/{document=**} { allow read, write: if false; }
    match /billingCheckouts/{document=**} { allow read, write: if false; }
    match /billingCustomers/{document=**} { allow read, write: if false; }
    match /billingSubscriptions/{document=**} { allow read, write: if false; }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && clientCanCreatePlan();
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && userPlanLocked()
        && (!("createdAt" in resource.data)
          || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isOwner(userId);

      match /aiUsageWeeks/{weekStart} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

    match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMemory(memoryId, request.resource.data);
        allow update: if isOwner(userId)
          && isValidMemory(memoryId, request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /profile/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && docId == "learning" && isValidLearning(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    match /chats/{chatId} {
      allow read: if (signedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin()))
        || resource.data.public == true;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && shareFieldsAbsent(request.resource.data);
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && shareFieldsUnchangedOrValid();
    }

    match /projects/{projectId} {
      allow read: if signedIn() && (resource == null
        || resource.data.userId == request.auth.uid
        || resource.data.ownerId == request.auth.uid);
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid
        || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid)
        && request.resource.data.userId == request.auth.uid;

      match /chats/{threadId} {
        allow read: if ownsProject(projectId) || sharedThread(projectId, threadId);

        match /messages/{messageId} {
          allow read: if ownsProject(projectId) || sharedThread(projectId, threadId);
        }
      }

      match /materials/{materialId} {
        allow read: if ownsProject(projectId) || materialIsShared();
      }

      match /studySheets/{sheetId} {
        allow read: if ownsProject(projectId) || sheetIsShared();
      }

      match /{document=**} {
        allow read, write: if ownsProject(projectId);
      }
    }

    match /trainingSignals/{signalId} {
      allow create: if (signedIn()
          && request.resource.data.keys().hasOnly(["userId", "projectId", "contextType", "signal", "shortHash", "itemId", "createdAt"])
          && request.resource.data.userId == request.auth.uid)
        || isCompactFeedback(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /feedbackReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["messageId", "projectId", "reason", "note", "createdAt"])
        && request.resource.data.keys().hasAll(["messageId", "projectId", "reason", "note", "createdAt"])
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && request.resource.data.projectId.size() <= 160
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() > 0
        && request.resource.data.messageId.size() <= 160
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string)
        && ownsProject(request.resource.data.projectId);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /playgroundSnapshots/{snapshotId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /evalSnapshots/{snapshotId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Generation job payloads and queue state are only accessible through the
    // authenticated backend. Admin SDK workers bypass these client rules.
    match /generationJobs/{jobId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /generationJobLimits/{userId} {
      allow read, write: if false;
    }

    match /generationJobRequests/{requestId} {
      allow read, write: if false;
    }
  }
}
