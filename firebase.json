{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "tobyverse.web.app",
      "tobyverse.firebaseapp.com",
      "ugstuff-c351a.web.app",
      "ugstuff-c351a.firebaseapp.com",
      "tobyverse.ge"
    ],
    "providers": {
      "googleSignIn": {
        "authorizedRedirectUris": [
          "http://localhost",
          "http://localhost:3000",
          "http://localhost:3000/__/auth/handler",
          "http://localhost:3000/login/google-callback",
          "http://127.0.0.1:3000/__/auth/handler",
          "http://127.0.0.1:3000/login/google-callback",
          "https://tobyverse.web.app",
          "https://tobyverse.web.app/__/auth/handler",
          "https://tobyverse.web.app/login/google-callback",
          "https://tobyverse.ge",
          "https://tobyverse.ge/__/auth/handler",
          "https://tobyverse.ge/login/google-callback",
          "https://ugstuff-c351a.firebaseapp.com/__/auth/handler",
          "https://ugstuff-c351a.web.app/__/auth/handler"
        ]
      }
    }
  },
  "hosting": {
    "site": "tobyverse",
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "1GiB"
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
