{
  "name": "tobyverse",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "dev:frontend": "npm run dev --workspace @tobyverse/frontend",
    "dev:backend": "npm run dev --workspace @tobyverse/backend",
    "dev:stack": "node scripts/dev-stack.mjs",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build",
    "build:frontend": "npm run build --workspace @tobyverse/frontend",
    "build:backend": "npm run build --workspace @tobyverse/backend",
    "build:stack": "npm run build:backend && npm run build:frontend",
    "start": "next start --port 3000",
    "start:backend": "npm run start --workspace @tobyverse/backend",
    "jobs:inspect": "npm run jobs:inspect --workspace @tobyverse/backend",
    "test:stack": "node --test tests/parallel-stack.test.cjs && npm run test --workspace @tobyverse/backend && npm run test:jobs --workspace @tobyverse/backend && npm run test --workspace @tobyverse/frontend",
    "lint": "eslint",
    "deploy": "npm run clean && next build && firebase deploy --only auth,hosting --force"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-virtual": "3.14.21",
    "firebase": "^11.10.0",
    "firebase-admin": "^14.3.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.2",
    "motion": "^13.2.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.5.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "overrides": {
    "firebase-frameworks": {
      "firebase-admin": "$firebase-admin"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "^5"
  }
}
